{
  "_about": "Models _tools/muapi-image.mjs knows how to call. Pick one in CLAUDE.md Settings (Image model / Video model) or with /models. Any other muapi model name also works, but its fields are sent as-is. Prices: muapi.ai pricing page.",
  "defaults": { "image": "nano-banana-pro", "video": "kling-v3.0-standard-image-to-video" },
  "image": {
    "nano-banana-pro":         { "note": "Google Nano Banana Pro. Very realistic photos (default)",
