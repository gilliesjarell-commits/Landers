    "nano-banana":             { "note": "Original Nano Banana. Faster, a step below Pro",
                                 "ratios": ["1:1","3:4","4:3","9:16","16:9","3:2","2:3","5:4","4:5","21:9"] },
    "google-imagen4-ultra":    { "note": "Google Imagen 4 Ultra. Top Imagen quality",
                                 "ratios": ["16:9","9:16","1:1","4:3","3:4"] },
    "google-imagen4":          { "note": "Google Imagen 4",
                                 "ratios": ["16:9","9:16","1:1","4:3","3:4"] },
    "google-imagen4-fast":     { "note": "Google Imagen 4 Fast",
                                 "ratios": ["16:9","9:16","1:1","4:3","3:4"] },
    "bytedance-seedream-v4.5": { "note": "ByteDance Seedream 4.5",
                                 "ratios": ["1:1","16:9","9:16","4:3","3:4","2:3","3:2","21:9"], "extra": { "quality": "high" } },
    "bytedance-seedream-v4":   { "note": "ByteDance Seedream 4",
                                 "ratios": ["1:1","16:9","9:16","3:4","4:3","2:3","3:2","21:9"], "resolution": { "field": "resolution", "value": "1K" } },
    "flux-2-pro":              { "note": "Black Forest Labs FLUX.2 Pro",
                                 "ratios": ["16:9","9:16","1:1","4:3","3:4","2:3","3:2"], "resolution": { "field": "resolution", "value": "1k" } },
    "flux-krea-dev":           { "note": "FLUX Krea. Natural, less 'AI-looking' photos",
                                 "ratios": ["16:9","9:16","1:1","4:3","3:4","3:2","2:3","21:9","9:21"] },
    "kling-o1-text-to-image":  { "note": "Kling O1 image",
                                 "ratios": ["16:9","9:16","1:1","4:3","3:4","2:3","3:2","21:9"], "resolution": { "field": "resolution", "value": "1k" } },
    "gpt-image-1.5":           { "note": "OpenAI GPT Image 1.5 (only square, 2:3 and 3:2 shapes)",
                                 "ratios": ["1:1","2:3","3:2"], "extra": { "quality": "high" } }
  },
  "video": {
    "kling-v3.0-standard-image-to-video": { "note": "Kling 3.0 Standard. Talking narrator with voice, up to 15 s in one clip (default)",
                                            "image": "image_url", "seconds": { "min": 3, "max": 15 }, "audio": "generate_audio" },
    "kling-v3.0-pro-image-to-video":      { "note": "Kling 3.0 Pro. Same as Standard, higher quality",
                                            "image": "image_url", "seconds": { "min": 3, "max": 15 }, "audio": "generate_audio" },
    "openai-sora-2-image-to-video":       { "note": "OpenAI Sora 2. Voice built in, 10 or 15 s",
                                            "image": "images_list", "seconds": [10, 15], "ratios": ["16:9","9:16"] },
    "seedance-v1.5-pro-i2v":              { "note": "ByteDance Seedance 1.5 Pro. Voice, up to 12 s (15 s ads use 2 clips)",
                                            "image": "image_url", "seconds": { "min": 4, "max": 12 }, "audio": "generate_audio",
                                            "ratios": ["16:9","9:16","1:1","3:4","4:3","21:9"], "extra": { "resolution": "720p" } },
    "veo3.1-image-to-video":              { "note": "Google Veo 3.1. Voice built in, 8 s clips (15 s ads use 2 clips)",
