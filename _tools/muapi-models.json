    "veo3.1-fast-image-to-video":         { "note": "Google Veo 3.1 Fast. Voice built in, 8 s clips (15 s ads use 2 clips)",
                                            "image": "image_url", "seconds": [8], "ratios": ["16:9","9:16"], "extra": { "resolution": "1080p" } },
    "ltx-2-fast-image-to-video":          { "note": "LTX-2 Fast. Voice, up to 20 s",
                                            "image": "image_url", "seconds": [6, 8, 10, 12, 14, 16, 18, 20], "audio": "generate_audio" }
